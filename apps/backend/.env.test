# Loaded by the tests (test/helper.ts) and `npm run test:setup`, on top of .env: a separate database and storage directory, so tests never touch dev data. Variables already set in the shell win, which is how CI sets its own.

DATABASE_URL=postgres://postgres:postgres@localhost:5432/personal_document_manager_test

# Inside the dev storage directory, so the dev server's file watcher ignores it and .gitignore covers it.
STORAGE_DIR=./storage/test
