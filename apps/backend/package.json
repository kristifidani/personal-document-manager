{
  "name": "backend",
  "version": "0.0.1",
  "private": true,
  "description": "Personal Document Manager backend API (Fastify)",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "fastify start -w --ignore-watch='/storage(/|$)' -P -r ts-node/register src/app.ts",
    "build": "tsc",
    "start": "npm run build && fastify start dist/app.js",
    "test": "npm run test:setup && node --test --test-concurrency=1 -r ts-node/register \"test/**/*.test.ts\"",
    "typecheck": "tsc -p test/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip --directory ../..",
    "migrate:create": "node --env-file-if-exists=.env ../../node_modules/node-pg-migrate/bin/node-pg-migrate.js create -j sql",
    "migrate:up": "node --env-file-if-exists=.env ../../node_modules/node-pg-migrate/bin/node-pg-migrate.js up",
    "migrate:down": "node --env-file-if-exists=.env ../../node_modules/node-pg-migrate/bin/node-pg-migrate.js down",
    "test:setup": "node --env-file=.env.test ../../node_modules/node-pg-migrate/bin/node-pg-migrate.js up && node --env-file=.env.test -r ts-node/register test/reset-data.ts",
    "data:reset": "node --env-file-if-exists=.env -r ts-node/register test/reset-data.ts",
    "samples:upload": "node --env-file-if-exists=.env -r ts-node/register test/upload-samples.ts",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run knip && npm test"
  },
  "dependencies": {
    "@fastify/autoload": "^6.5.1",
    "@fastify/env": "^7.0.1",
    "@fastify/error": "^4.2.1",
    "@fastify/multipart": "^10.1.6",
    "@fastify/postgres": "^6.1.1",
    "fastify": "^5.12.5",
    "fastify-cli": "^8.0.2",
    "fastify-plugin": "^6.0.1",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.0",
    "shared": "*"
  }
}
