# Copy to .env (gitignored).

# Read by fastify-cli, which starts the server, so they aren't in src/plugins/env.ts.
PORT=3000
FASTIFY_LOG_LEVEL=info

# Matches infra/db/docker-compose.yml's default credentials.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/personal_document_manager

# Local directory where uploaded documents are stored on disk.
STORAGE_DIR=./storage

# Claude API key for Ask (console.anthropic.com).
ANTHROPIC_API_KEY=
