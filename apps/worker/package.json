{
  "name": "worker",
  "version": "0.0.1",
  "private": true,
  "description": "Personal Document Manager background worker (document processing jobs)",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch -r ts-node/register src/main.ts",
    "build": "tsc",
    "start": "npm run build && node dist/main.js",
    "test": "npm run data:reset && node --test --test-concurrency=1 -r ts-node/register \"test/**/*.test.ts\"",
    "typecheck": "tsc -p test/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "data:reset": "npm --prefix ../backend run data:reset",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run knip && npm test"
  },
  "dependencies": {
    "env-schema": "^8.0.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.6",
    "@types/pg": "^8.23.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "knip": "^6.37.0",
    "prettier": "^3.9.8",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
