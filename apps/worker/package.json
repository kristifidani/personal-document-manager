{
  "name": "worker",
  "version": "0.0.1",
  "private": true,
  "description": "Personal Document Manager background worker (document processing jobs)",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch -r ts-node/register src/main.ts",
    "build": "tsc",
    "start": "npm run build && node dist/main.js",
    "test": "npm run data:reset && node --test --test-concurrency=1 -r ts-node/register \"test/**/*.test.ts\"",
    "typecheck": "tsc -p test/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip --directory ../..",
    "data:reset": "npm run data:reset -w backend",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run knip && npm test"
  },
  "dependencies": {
    "env-schema": "^7.0.0",
    "pg": "^8.23.0"
  }
}
