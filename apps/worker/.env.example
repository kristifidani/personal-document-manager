# Copy to .env (gitignored).

# Same database as the backend (apps/backend/.env).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/personal_document_manager

# Where the backend stores uploads; both apps must see the same files.
STORAGE_DIR=../backend/storage

# Claude API key for OCR (console.anthropic.com). Never commit it.
ANTHROPIC_API_KEY=

# Lowest level logged: fatal, error, warn, info, debug, trace or silent. debug adds each step inside a job.
LOG_LEVEL=info
