{
  "name": "personal-document-manager",
  "private": true,
  "scripts": {
    "format": "prettier --write \"*.{md,json,jsonc,mjs}\" infra .github samples .vscode",
    "format:check": "prettier --check \"*.{md,json,jsonc,mjs}\" infra .github samples .vscode"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "knip": "^6.43.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
