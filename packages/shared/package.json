{
  "name": "shared",
  "version": "0.0.1",
  "private": true,
  "description": "Personal Document Manager code shared by the apps",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    "./claude": "./src/claude.ts"
  },
  "scripts": {
    "typecheck": "tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip --directory ../..",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run knip"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0"
  }
}
